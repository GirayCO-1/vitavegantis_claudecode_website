# İletişim formunun mail gönderme ayarları.
#
# Bu dosya örnektir; gerçek değerler BURAYA YAZILMAZ. Değerleri Vercel'de
# Project Settings → Environment Variables ekranından girin. Yerelde denemek
# için bu dosyayı ".env.local" adıyla kopyalayın — .env.local git'e girmez.
#
# Mail, IHS'deki kendi hesabımızın SMTP'si üzerinden gider; üçüncü bir
# servise veri aktarılmaz. Bilgileri IHS panelinden (Plesk → E-posta) alın.

# SMTP sunucusu — genelde mail.<alanadi> veya IHS'nin verdiği sunucu adı.
SMTP_HOST=mail.vitavegantis.com

# 465 = doğrudan SSL (önerilir), 587 = STARTTLS.
SMTP_PORT=465

# Gönderici hesap. From başlığında da bu adres kullanılır.
SMTP_USER=info@vitavegantis.com

# Hesabın parolası. Yalnızca Vercel ortam değişkenlerinde tutulur.
SMTP_PASS=

# Mesajların düşeceği adres. Boş bırakılırsa SMTP_USER'a gider.
CONTACT_TO=info@vitavegantis.com
